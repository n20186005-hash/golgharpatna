---
import Base from '../layouts/Base.astro';
import Weather from './Weather.astro';
import type { Locale } from '../content/guide-schema';
import {
  GROUPS,
  MAP_EMBED,
  MAP_URL,
  ORIGIN,
  REVIEW_COUNT,
  REVIEWED_ON_TEXT,
  MAPS_OBSERVED_ON_TEXT,
  SITE_NAME,
  GEO,
  RATING,
  urlFor
} from '../lib/site';

const { locale } = Astro.props as { locale: Locale };

type HomeLink = { label: string; path?: string; url?: string };
type GlanceRow = { label: string; value: string; link: string; path: string };
type HourRow = { source: string; hours: string; when: string; url: string };
type Section = { id: string; heading: string; text: string; links: HomeLink[]; map?: boolean };
type Faq = { q: string; a: string };

type Content = {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  h1Note: string;
  lead: string;
  ctaPrimary: HomeLink;
  ctaMap: string;
  heroNote: string;
  imageAlt: string;
  stats: { value: string; label: string }[];
  glance: { eyebrow: string; heading: string; intro: string; rows: GlanceRow[] };
  hours: { eyebrow: string; heading: string; intro: string; columns: [string, string, string]; rows: HourRow[]; note: string; link: HomeLink };
  sections: Section[];
  guide: { eyebrow: string; heading: string; intro: string };
  weather: { eyebrow: string; heading: string; intro: string; link: HomeLink };
  faq: { eyebrow: string; heading: string; items: Faq[] };
  sources: { heading: string; paragraphs: string[]; images: string; legal: string };
  sectionEyebrow: string;
  reviewed: string;
};

const BT_URL = 'https://tourism.bihar.gov.in/';
const II_URL = 'https://www.incredibleindia.org/';
const DISTRICT_URL = 'https://patna.nic.in/tourist-place/gol-ghar/';
const OSM = { lat: GEO.lat, lng: GEO.lng };

const C: Content =
  locale === 'hi'
    ? {
        title: 'गोलघर पटना: कहाँ है, समय, टिकट और इतिहास | 2026 गाइड',
        description:
          'गोलघर पटना कहाँ है, दिनांकित खुलने का समय, टिकट की जाँच, 1786 का इतिहास और यात्रा की तैयारी। स्वतंत्र हिंदी मार्गदर्शिका; वर्तमान पहुँच स्थानीय निर्देश से जाँचें।',
        eyebrow: 'पटना · बिहार · स्वतंत्र हिंदी मार्गदर्शिका',
        h1: 'गोलघर पटना',
        h1Note: '(Golghar Patna)',
        lead: '1786 का ऐतिहासिक अनाजघर—स्थान, इतिहास और यात्रा की तैयारी समझें। खुलने का समय, शुल्क और ऊपर जाने की अनुमति पहले जाँचें।',
        ctaPrimary: { label: 'यात्रा की जानकारी', path: '#visit' },
        ctaMap: 'मानचित्र खोलें',
        heroNote: 'चित्र: मूल सांकेतिक रेखाचित्र; वास्तविक फोटो या मापचित्र नहीं।',
        imageAlt: 'गोलघर का मूल वैचारिक रेखाचित्र, वास्तविक फोटो नहीं',
        stats: [
          { value: '1786', label: 'निर्माण का वर्ष' },
          { value: '145', label: 'ऐतिहासिक सीढ़ियों का विवरण' },
          { value: '29 मी.', label: 'लगभग ऊँचाई' },
          { value: `${RATING} / 5`, label: `Google Maps · ${REVIEW_COUNT} समीक्षाएँ · ${REVIEWED_ON_TEXT.hi} को देखा गया` }
        ],
        glance: {
          eyebrow: 'एक नज़र में',
          heading: 'गोलघर की यात्रा की मुख्य जानकारी',
          intro: 'हर पंक्ति के आगे उसका विस्तृत पृष्ठ दिया है। जहाँ स्रोत अलग हैं, वहाँ दोनों तारीख के साथ दिए गए हैं।',
          rows: [
            { label: 'स्थान', value: 'अशोक राजपथ, गांधी मैदान के पश्चिम', link: 'स्थान और मानचित्र', path: 'visit/location' },
            { label: 'खुलने का समय', value: 'स्रोतों में अंतर—नीचे तीनों स्रोत तारीख के साथ देखें', link: 'समय और साप्ताहिक अवकाश', path: 'visit/timings' },
            { label: 'टिकट', value: 'इस समीक्षा में वर्तमान दर की पुष्टि नहीं', link: 'टिकट और शुल्क जाँचें', path: 'visit/tickets' },
            { label: 'ऊपर जाना', value: 'ऐतिहासिक रूप से 145 सीढ़ियाँ; ऊपर की वर्तमान अनुमति अपुष्ट', link: 'सीढ़ियों की वर्तमान स्थिति', path: 'visit/staircase-access' },
            { label: 'पहुँच', value: 'मानचित्र से रास्ता; पटना जंक्शन और हवाई अड्डे से मार्ग', link: 'पटना जंक्शन से कैसे पहुँचें', path: 'visit/patna-junction' },
            { label: 'आसपास', value: 'संग्रहालय, खान-पान और आधे दिन की योजनाएँ', link: 'आसपास के स्थल', path: 'nearby' }
          ]
        },
        hours: {
          eyebrow: 'खुलने का समय: तीन स्रोत',
          heading: 'समय पर स्रोत एक जैसे नहीं',
          intro: 'नीचे दिए समय सार्वजनिक सूचियों के हैं। ये आज की संचालन-पुष्टि नहीं हैं; स्थल पर जाने से पहले समय जाँचें।',
          columns: ['स्रोत', 'बताया गया समय', 'कब / कहाँ से'],
