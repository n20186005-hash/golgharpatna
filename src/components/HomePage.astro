            links: [
              { label: 'गोलघर का इतिहास', path: 'history' },
              { label: 'वास्तुकला', path: 'architecture' },
              { label: '1770 का अकाल और अनाजघर', path: 'history/granary-famine' }
            ]
          },
          {
            id: 'architecture',
            heading: 'गुंबद और घुमावदार सीढ़ियाँ',
            text: 'जिला प्रशासन गोलघर को स्तंभ-रहित संरचना बताता है। लगभग 29 मीटर ऊँचाई, आधार पर लगभग 3.6 मीटर मोटी दीवार और 145 सीढ़ियाँ इसकी पहचान हैं। सीढ़ियों का ऐतिहासिक उपयोग ऊपर से अनाज पहुँचाने और दूसरी ओर से उतरने के लिए था। पुराना विवरण आज ऊपर चढ़ने की अनुमति की गारंटी नहीं है।',
            links: [
              { label: '145 सीढ़ियों की बनावट', path: 'history/staircases' },
              { label: 'मरम्मत की स्थिति', path: 'restoration-status' },
              { label: 'सीढ़ियों की वर्तमान पहुँच', path: 'visit/staircase-access' }
            ]
          },
          {
            id: 'visit',
            heading: 'समय, टिकट और पहुँच पहले जाँचें',
            text: 'Google Maps की 23 अक्टूबर 2026 की सूची में मंगलवार–रविवार 09:00–17:00 और सोमवार बंद है। बिहार पर्यटन और Incredible India की सूचियाँ 18:00 तक का समय बताती हैं। किसी एक सूची को अंतिम न मानें। वर्तमान प्रवेश शुल्क, कार्यक्रम और ऊपरी भाग की पहुँच की पुष्टि इस समीक्षा में नहीं हुई; स्थल के निर्देश देखें।',
            links: [
              { label: 'खुलने का समय और अवकाश', path: 'visit/timings' },
              { label: 'टिकट और शुल्क', path: 'visit/tickets' },
              { label: 'ऊपर जाना: वर्तमान स्थिति', path: 'visit/staircase-access' }
            ]
          },
          {
            id: 'facilities',
            heading: 'अपनी जरूरतों के अनुसार तैयारी',
            text: 'पानी और मौसम के अनुकूल वस्त्र रखें। शौचालय, बैठने की जगह, व्हीलचेयर-अनुकूल पहुँच या अन्य सुविधा की उपलब्धता पहले जाँचें; यह मार्गदर्शिका इनकी वर्तमान उपलब्धता प्रमाणित नहीं करती। बच्चों के साथ उपलब्ध, अनुमति वाले मार्ग पर रहें और सीढ़ियों पर स्थानीय सुरक्षा निर्देश मानें।',
            links: [
              { label: 'पहुँच और गतिशीलता', path: 'visit/accessibility' },
              { label: 'परिवार के साथ यात्रा', path: 'visit/family-facilities' },
              { label: 'पार्किंग और आसपास', path: 'visit/parking' }
            ]
          },
          {
            id: 'transport',
            heading: 'स्थान और आने-जाने की योजना',
            text: 'संदर्भ पता गवर्नमेंट गर्ल्स हाई स्कूल के सामने, अशोक राजपथ रोड, पटना 800001 है। प्रस्थान स्थल के अनुसार मानचित्र में रास्ता चुनें। सार्वजनिक परिवहन की लाइन, किराया और पड़ाव वर्तमान सेवा से जाँचें। वाहन से आने पर अधिकृत पार्किंग और स्थानीय संकेत देखें; यात्रा या पैदल चलने का निश्चित समय यहाँ नहीं दिया जाता।',
            map: true,
