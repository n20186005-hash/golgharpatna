            { source: 'बिहार पर्यटन — गंतव्य सूची', hours: '09:00–18:00 (प्रवेश निःशुल्क बताया गया)', when: 'सार्वजनिक सूची; सूची में तारीख नहीं दी गई', url: BT_URL },
