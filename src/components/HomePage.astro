        sectionEyebrow: 'Golghar travel guide',
        reviewed: 'Last reviewed'
      };

const faq = C.faq.items;

const href = (link: HomeLink): string => link.url ?? urlFor(locale, (link.path ?? '').replace(/^#/, ''));

const schema: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': ORIGIN + '/#attraction',
    name: locale === 'hi' ? 'गोलघर, पटना' : 'Golghar, Patna',
    alternateName: ['Golghar Patna', 'Gol Ghar', 'गोलघर'],
    url: ORIGIN + urlFor(locale),
    description: C.description,
    geo: { '@type': 'GeoCoordinates', latitude: OSM.lat, longitude: OSM.lng },
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Opp. Govt. Girls High School, Ashok Rajpath Road',
      addressLocality: 'Patna',
      addressRegion: 'Bihar',
      postalCode: '800001',
      addressCountry: 'IN'
    },
    hasMap: MAP_URL
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': ORIGIN + '/#website',
    url: ORIGIN + urlFor(locale),
    name: SITE_NAME[locale],
    inLanguage: locale === 'hi' ? 'hi-IN' : 'en'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
  }
];
---
<Base title={C.title} description={C.description} lang={locale} altPath="" {schema}>
  <section class="relative overflow-hidden bg-[#201f1a] text-white">
    <div class="absolute inset-0 opacity-45">
      <img class="photo" src="/images/golghar-hero.jpg" alt={C.imageAlt} width="1200" height="800" fetchpriority="high" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-transparent"></div>
    <div class="shell relative grid min-h-[640px] items-end gap-10 py-20 lg:grid-cols-[1.1fr_.8fr]">
      <div>
        <p class="text-sm font-bold text-[#e7c785]">{C.eyebrow}</p>
        <h1 class="mt-4 text-6xl font-black leading-tight md:text-8xl">
          {C.h1} <span class="text-3xl font-bold text-stone-300 md:text-5xl">{C.h1Note}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-xl text-stone-200">{C.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn hero-light" href="#visit">{C.ctaPrimary.label}</a>
          <a class="btn btn-ghost" href={MAP_URL} target="_blank" rel="noopener noreferrer">{C.ctaMap}</a>
        </div>
        <p class="mt-6 text-xs text-stone-200">{C.heroNote}</p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {C.stats.map((stat) => (
          <div class="rounded-3xl bg-white/10 p-5">
            <strong class="text-3xl">{stat.value}</strong>
            <span class="block">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="glance" class="section">
    <div class="shell">
      <p class="eyebrow">{C.glance.eyebrow}</p>
      <h2 class="section-title mt-3">{C.glance.heading}</h2>
      <p class="mt-5 max-w-3xl text-lg text-stone-700">{C.glance.intro}</p>
      <div class="mt-8 overflow-x-auto">
        <table class="data-table">
          <tbody>
            {C.glance.rows.map((row) => (
              <tr>
                <th scope="row" class="w-40">{row.label}</th>
                <td>{row.value}</td>
                <td class="w-64">
                  <a class="underline" href={urlFor(locale, row.path)}>{row.link}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="hours" class="section bg-[#e9dfd0]">
    <div class="shell">
      <p class="eyebrow">{C.hours.eyebrow}</p>
      <h2 class="section-title mt-3">{C.hours.heading}</h2>
      <p class="mt-5 max-w-3xl text-lg text-stone-700">{C.hours.intro}</p>
      <div class="mt-8 overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{C.hours.columns[0]}</th>
              <th scope="col">{C.hours.columns[1]}</th>
              <th scope="col">{C.hours.columns[2]}</th>
            </tr>
          </thead>
          <tbody>
            {C.hours.rows.map((row) => (
              <tr>
                <td>
                  <a class="underline" href={row.url} target="_blank" rel="noopener noreferrer">{row.source}</a>
                </td>
                <td><strong>{row.hours}</strong></td>
                <td class="text-sm muted">{row.when}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note mt-6">{C.hours.note}</p>
      <p class="mt-6">
        <a class="btn btn-primary" href={urlFor(locale, C.hours.link.path!)}>{C.hours.link.label}</a>
      </p>
    </div>
  </section>

  {C.sections.map((section, i) => (
    <section id={section.id} class={`section ${i % 2 ? 'bg-[#e9dfd0]' : ''}`}>
      <div class="shell grid gap-9 lg:grid-cols-[1.1fr_.8fr]">
        <article>
          <p class="eyebrow">{C.sectionEyebrow}</p>
          <h2 class="section-title mt-3">{section.heading}</h2>
          <p class="mt-6 text-lg text-stone-700">{section.text}</p>

          {section.id === 'transport' && (
            <p class="mt-4">
              <span>{locale === 'hi' ? 'स्थान बिंदु: ' : 'Reference point: '}</span>
              <bdi dir="ltr">25.620337, 85.139448</bdi>
              <a class="ml-3 underline" href={MAP_URL} target="_blank" rel="noopener noreferrer">{C.ctaMap}</a>
            </p>
          )}

          {section.map && (
            <figure class="mt-6">
              <iframe class="map-frame" title={locale === 'hi' ? 'गोलघर पटना का मानचित्र' : 'Map of Golghar, Patna'} src={MAP_EMBED} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </figure>
          )}

          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {section.links.map((link) => (
              <li>
                <a class="link-card" href={href(link)} {...(link.url ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <span>{link.label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>

          {section.id === 'history' && (
            <p class="mt-4">
              <a class="underline" href={DISTRICT_URL} target="_blank" rel="noopener noreferrer">
                {locale === 'hi' ? 'पटना जिला प्रशासन — गोलघर का इतिहास' : 'Patna district administration — Golghar history'}
              </a>
            </p>
          )}
        </article>
        <figure class="card overflow-hidden">
          <img
            src={'/images/golghar-' + (i % 2 ? 'stairs' : 'wide') + '.jpg'}
            alt={locale === 'hi' ? 'पटना में गोलघर का वास्तविक दृश्य' : 'Photograph of Golghar in Patna'}
            width="1200"
            height="800"
            loading="lazy"
            class="w-full"
          />
          <figcaption class="p-4 text-xs muted">
            {locale === 'hi' ? 'पटना में गोलघर का वास्तविक फोटो।' : 'Photograph of Golghar in Patna.'}
          </figcaption>
        </figure>
      </div>
    </section>
  ))}

  <section class="section bg-[#e9dfd0]">
    <div class="shell">
      <p class="eyebrow">{C.guide.eyebrow}</p>
      <h2 class="section-title mt-3">{C.guide.heading}</h2>
      <p class="mt-5 max-w-3xl text-lg text-stone-700">{C.guide.intro}</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {GROUPS.map((group) => (
          <a class="card block p-6 no-underline" href={urlFor(locale, group.id)}>
            <strong class="text-lg font-black">{group.label[locale]}</strong>
            <span class="mt-2 block text-sm muted">{group.intro[locale]}</span>
            <span aria-hidden="true" class="mt-3 block text-sm font-bold text-[#8f4e36]">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell max-w-3xl">
      <p class="eyebrow">{C.weather.eyebrow}</p>
      <h2 class="section-title mt-3">{C.weather.heading}</h2>
      <p class="mt-5 text-lg text-stone-700">{C.weather.intro}</p>
      <p class="mt-4">
        <a class="underline" href={urlFor(locale, C.weather.link.path!)}>{C.weather.link.label}</a>
      </p>
    </div>
  </section>

  <div id={locale === 'hi' ? 'मौसम-रणनीति' : 'weather-section'}>
    <Weather locale={locale} />
  </div>

  <section id="faq" class="section">
    <div class="shell max-w-4xl">
      <p class="eyebrow">{C.faq.eyebrow}</p>
      <h2 class="section-title mt-3">{C.faq.heading}</h2>
      <div class="faq-list mt-8 divide-y divide-stone-300">
        {faq.map(({ q, a }) => (
          <details class="py-5">
            <summary class="text-lg">{q}</summary>
            <p class="mt-3 text-stone-700">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[#e9dfd0]">
    <div class="shell legal">
      <h2>{C.sources.heading}</h2>
      <p class="mt-2 text-sm muted">{C.reviewed}: {REVIEWED_ON_TEXT[locale]}</p>
      {C.sources.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>{C.sources.images}</p>
      <p>{C.sources.legal}</p>
      <p class="mt-4">
        <a href={urlFor(locale, 'visit/timings')}>{locale === 'hi' ? 'समय और अवकाश' : 'Hours and closure'}</a> ·{' '}
        <a href={urlFor(locale, 'visit/staircase-access')}>{locale === 'hi' ? 'सीढ़ियों की स्थिति' : 'Staircase access'}</a> ·{' '}
        <a href={urlFor(locale, 'cookies')}>{locale === 'hi' ? 'विश्लेषण की पसंद' : 'Analytics choice'}</a> ·{' '}
        <a href={urlFor(locale, 'privacy')}>{locale === 'hi' ? 'गोपनीयता' : 'Privacy'}</a> ·{' '}
        <a href={urlFor(locale, 'terms')}>{locale === 'hi' ? 'उपयोग की शर्तें' : 'Terms'}</a>
      </p>
    </div>
  </section>
</Base>
