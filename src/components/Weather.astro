---
import {validateWeather,weatherUrl,nowHtml,daysHtml,buildAdvice,renderAdvice} from '../lib/weather';
let wx:any=null;
const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),12000);
try{const response=await fetch(weatherUrl,{signal:controller.signal});if(response.ok)wx=validateWeather(await response.json());}catch{wx=null;}finally{clearTimeout(timer);}
---


<section id="मौसम" class="section">
  <div class="shell">
    <p class="eyebrow">मौसम और योजना</p>
    <h2 class="section-title mt-3">प्रदाता का मौसम और 7 दिन का पूर्वानुमान</h2>

    <!-- स्थिर (हमेशा दिखने वाला) सलाह-भाग -->
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="card p-5">
        <h3 class="font-black">घूमने का सबसे अच्छा समय</h3>
        <p class="mt-2 text-sm muted">अक्टूबर–मार्च सबसे सुहाना मौसम; सितंबर–अप्रैल आरामदायक। सर्दियों की सुबह कोहरा संभव है।</p>
      </div>
      <div class="card p-5">
        <h3 class="font-black">गर्मी (मार्च–जून)</h3>
        <p class="mt-2 text-sm muted">दिन बहुत गर्म हो सकते हैं। सुबह जल्दी या देर दोपहर में जाएँ; पानी साथ रखें।</p>
      </div>
      <div class="card p-5">
        <h3 class="font-black">मानसून (जुलाई–सितंबर)</h3>
        <p class="mt-2 text-sm muted">बारिश के कारण सीढ़ियाँ फिसलन भरी हो सकती हैं; छाता रखें और पूर्वानुमान देखें।</p>
      </div>
    </div>

    <!-- गतिशील भाग (सर्वर से प्राप्त + क्लाइंट रिफ्रेश) -->
    <div id="weather-root" data-weather-snapshot={JSON.stringify(wx)} class="mt-6 grid gap-5 lg:grid-cols-[.9fr_1.1fr]">
      <div class="card p-7">
        <p class="text-sm font-black text-stone-500">आज का मौसम</p>
        <div id="wx-now" class="mt-2 rounded-2xl bg-[#f5efe5] p-6 text-sm muted" set:html={wx ? nowHtml(wx) : 'मौसम की जानकारी अभी उपलब्ध नहीं है।'}></div>
        <div id="wx-advice" class="mt-3 space-y-3" set:html={wx ? renderAdvice(buildAdvice(wx)) : ''}></div>
      </div>
      <div class="card p-7">
        <p class="text-sm font-black text-stone-500">आगामी 7 दिन</p>
        <div id="wx-days" class="mt-2 rounded-2xl bg-[#f5efe5] p-4 text-sm muted" set:html={wx ? daysHtml(wx) : 'मौसम की जानकारी अभी उपलब्ध नहीं है।'}></div>
      </div>
    </div>
    <p id="wx-status" class="mt-4 text-xs text-stone-500">निर्माण के समय प्राप्त पूर्वानुमान; ब्राउज़र नवीनतम जानकारी लेने की कोशिश करता है। स्रोत: <a class="underline" href="https://open-meteo.com/">Open-Meteo</a>। यह पूर्वानुमान है; वास्तविक स्थिति भिन्न हो सकती है—घूमने से पहले नवीनतम स्थिति की पुष्टि करें।</p>
  </div>
</section>

<script>
import {validateWeather,weatherUrl,nowHtml,daysHtml,buildAdvice,renderAdvice} from '../lib/weather';
const KEY='golghar-weather-v2',TTL=30*60*1000;
const root=document.getElementById('weather-root'),nowBox=document.getElementById('wx-now'),daysBox=document.getElementById('wx-days'),adviceBox=document.getElementById('wx-advice'),status=document.getElementById('wx-status');
const render=(d:any)=>{if(nowBox)nowBox.innerHTML=nowHtml(d);if(daysBox)daysBox.innerHTML=daysHtml(d);if(adviceBox)adviceBox.innerHTML=renderAdvice(buildAdvice(d));};
const message=(text:string)=>{if(status)status.textContent=text;};
async function refresh(){
 try{const cached=JSON.parse(localStorage.getItem(KEY)||'null'),age=Date.now()-cached?.t;if(cached&&typeof cached.t==='number'&&Number.isFinite(age)&&age>=0&&age<TTL){render(validateWeather(cached.data));message('हाल का स्थानीय कैश · प्रदाता का समय ऊपर दिया है। यह पूर्वानुमान है, स्थल की पहुँच की सूचना नहीं।');return;}}catch{}
 const ctrl=new AbortController(),timer=window.setTimeout(()=>ctrl.abort(),15000);
 try{const res=await fetch(weatherUrl,{signal:ctrl.signal});if(!res.ok)throw Error('Weather HTTP');const data=validateWeather(await res.json());try{localStorage.setItem(KEY,JSON.stringify({t:Date.now(),data}));}catch{}render(data);message('Open-Meteo से पूर्वानुमान प्राप्त हुआ। यह स्थल पर माप या प्रवेश की पुष्टि नहीं है।');}
 catch{try{const snapshot=validateWeather(JSON.parse(root?.dataset.weatherSnapshot||'null'));render(snapshot);message('नया पूर्वानुमान प्राप्त नहीं हुआ। हाल का निर्माण-समय स्नैपशॉट दिख रहा है; प्रदाता का समय देखें।');}catch{if(nowBox)nowBox.textContent='मौसम की जानकारी अभी उपलब्ध नहीं है।';if(daysBox)daysBox.innerHTML='';if(adviceBox)adviceBox.innerHTML='';message('नवीनतम पूर्वानुमान नहीं मिला। जानकारी फिर लेने के लिए पृष्ठ पुनः लोड करें; स्थानीय मौसम और स्थल के निर्देश देखें।');}}
 finally{window.clearTimeout(timer);}
}
refresh();
</script>