---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../content/guide-schema';
import { SITE_NAME, absoluteUrl } from '../lib/site';

const {
  title,
  description,
  lang = 'hi',
  altPath,
  image = '/images/golghar-hero.jpg',
  imageAlt,
  robots = 'index,follow',
  schema = []
} = Astro.props;

const locale = lang as Locale;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : undefined;
const ogImage = site ? new URL(image, site).toString() : undefined;
const altText = imageAlt ?? (locale === 'hi' ? 'पटना में गोलघर का वास्तविक फोटो' : 'Photograph of Golghar in Patna');
const skipLabel = locale === 'hi' ? 'मुख्य सामग्री पर जाएँ' : 'Skip to main content';
const hasAlternates = typeof altPath === 'string';
const hiUrl = hasAlternates ? absoluteUrl('hi', altPath) : undefined;
const enUrl = hasAlternates ? absoluteUrl('en', altPath) : undefined;
---
<!doctype html>
<html lang={locale === 'hi' ? 'hi-IN' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  {canonical && <link rel="canonical" href={canonical} />}
  {hiUrl && <link rel="alternate" hreflang="hi-IN" href={hiUrl} />}
  {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
  {hiUrl && <link rel="alternate" hreflang="x-default" href={hiUrl} />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME[locale]} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:alt" content={altText} />
  <meta property="og:locale" content={locale === 'hi' ? 'hi_IN' : 'en_IN'} />
  {hiUrl && <meta property="og:locale:alternate" content={locale === 'hi' ? 'en_IN' : 'hi_IN'} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <!-- PWA / Icons -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#1d241f" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content={locale === 'hi' ? 'गोलघर पटना' : 'Golghar Patna'} />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/favicon/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />

  {schema.map((item: any) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}

  <!-- GA4 (सहमति-गेटेड) -->
  <script is:inline src="/analytics.js"></script>
</head>
<body>
  <a class="skip" href="#main">{skipLabel}</a>
  <Header locale={locale} altPath={altPath} />
  <main id="main">
    <slot />
  </main>
  <Footer locale={locale} />

  <!-- PWA Service Worker (उत्पादन में ही) -->
  <script is:inline>
    (function(){var local=['localhost','127.0.0.1','0.0.0.0'];if('serviceWorker' in navigator&&local.indexOf(location.hostname)===-1){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){})})}})();
  </script>
</body>
</html>
