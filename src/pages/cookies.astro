---
import Base from '../layouts/Base.astro';
const title='कुकी और विश्लेषण सेटिंग्स | गोलघर पटना';const description='Google Analytics की अपनी पसंद सहेजें या वापस लें; स्थानीय संग्रहण विफल होने पर स्थिति देखें।';
---
<Base {title} {description} robots="noindex,follow"><section class="section"><div class="shell legal max-w-4xl"><p class="eyebrow">गोपनीयता नियंत्रण</p><h1 class="section-title mt-3">कुकी और विश्लेषण सेटिंग्स</h1><p class="mt-4">समीक्षा: 23 अक्टूबर 2026। यह नियंत्रण इस साइट के Google Analytics के लिए है। मौसम का कैश और ऑफलाइन प्रतियाँ स्थानीय सुविधाएँ हैं; इन्हें ब्राउज़र की साइट-डेटा सेटिंग में मिटाया जा सकता है। होस्टिंग की तकनीकी सेवाएँ अलग हैं।</p><form id="cookie-form" class="mt-8 grid gap-4"><label class="card flex items-center justify-between gap-5 p-6"><span><strong>Google Analytics</strong><small class="block muted">मापन पहचान G-HXM22WWPKP। चालू करने पर Google की सेवा से संपर्क होता है।</small></span><input id="analytics" type="checkbox" class="size-5"/></label><div class="flex flex-wrap gap-3"><button type="submit" class="btn btn-primary">पसंद सहेजें</button><button id="reject" type="button" class="btn btn-ghost">विश्लेषण बंद करें</button></div><p id="status" class="font-bold" role="status" aria-live="polite"></p></form><p class="mt-6"><a href="/privacy/">गोपनीयता और सेवा प्रदाता</a></p></div></section>
<script is:inline>
(()=>{const api=window.golgharAnalytics,form=document.getElementById('cookie-form'),box=document.getElementById('analytics'),status=document.getElementById('status'),reject=document.getElementById('reject');if(!api||!form||!box||!status||!reject)return;let limited=false;const sync=()=>box.checked=api.get();sync();const save=allow=>{const r=api.set(allow);limited=!r.saved&&!r.sharedOff;sync();status.textContent=r.saved?(r.effective?'विश्लेषण चालू है। पसंद इस ब्राउज़र में सहेजी और जाँची गई।':'विश्लेषण बंद है। पसंद इस ब्राउज़र में सहेजी और जाँची गई।'):(r.sharedOff?'पसंद चालू करने के लिए सहेजी नहीं जा सकी। विश्लेषण बंद है।':'इस पृष्ठ पर विश्लेषण बंद है। संग्रहण में बदलाव की पुष्टि नहीं हुई; दूसरा पृष्ठ या अगली यात्रा पुरानी अनुमति पढ़ सकती है।');};form.addEventListener('submit',e=>{e.preventDefault();save(box.checked)});reject.addEventListener('click',()=>save(false));window.addEventListener('storage',()=>{sync();if(!limited)status.textContent=api.get()?'संग्रहित पसंद के अनुसार विश्लेषण चालू है।':'इस पृष्ठ पर विश्लेषण बंद है।';});})();
</script></Base>
