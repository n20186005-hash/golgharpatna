---
import Base from '../layouts/Base.astro'; const title='कुकी सेटिंग्स | गोलघर पटना यात्रा मार्गदर्शिका'; const description='कुकी और Google Analytics प्राथमिकताओं का प्रबंधन करें।';
---
<Base {title} {description}><section class="section"><div class="shell max-w-4xl"><p class="eyebrow">गोपनीयता नियंत्रण</p><h1 class="section-title mt-3">कुकी सेटिंग्स</h1><p class="mt-3 muted">अंतिम अपडेट: सितंबर 2026</p><p class="mt-5">हम आपके ब्राउज़िंग अनुभव को बेहतर बनाने के लिए सीमित कुकी/स्थानीय स्टोरेज का उपयोग कर सकते हैं। आप नीचे अपनी पसंद बदल सकते हैं।</p><form id="cookie-form" class="mt-8 grid gap-4"><label class="card flex items-center justify-between gap-5 p-6"><span><strong>आवश्यक कुकी</strong><small class="block muted">वेबसाइट के मूल संचालन के लिए आवश्यक। इन्हें बंद नहीं किया जा सकता।</small></span><input type="checkbox" checked disabled class="size-5"/></label><label class="card flex items-center justify-between gap-5 p-6"><span><strong>विश्लेषण कुकी · Google Analytics</strong><small class="block muted">अनाम उपयोग पैटर्न समझने में मदद करती हैं।</small></span><input id="analytics" type="checkbox" class="size-5"/></label><label class="card flex items-center justify-between gap-5 p-6"><span><strong>प्राथमिकता कुकी</strong><small class="block muted">आपकी साइट सेटिंग याद रखने के लिए।</small></span><input id="preferences" type="checkbox" class="size-5"/></label><label class="card flex items-center justify-between gap-5 p-6"><span><strong>मार्केटिंग कुकी</strong><small class="block muted">यह साइट वर्तमान में व्यक्तिगत विज्ञापन नहीं चलाती; विकल्प डिफ़ॉल्ट रूप से बंद है।</small></span><input id="marketing" type="checkbox" class="size-5"/></label><div class="mt-3 flex flex-wrap gap-3"><button type="submit" class="btn btn-primary">पसंद सहेजें</button><button id="reject" type="button" class="btn btn-ghost">सभी वैकल्पिक कुकी अस्वीकार करें</button></div><p id="status" class="text-sm font-bold" aria-live="polite"></p></form></div></section><script is:inline>{`const key='golghar-cookie-consent';const a=document.getElementById('analytics'),p=document.getElementById('preferences'),m=document.getElementById('marketing'),s=document.getElementById('status');try{const x=JSON.parse(localStorage.getItem(key)||'{}');a.checked=!!x.analytics;p.checked=!!x.preferences;m.checked=!!x.marketing}catch(e){}document.getElementById('cookie-form').addEventListener('submit',e=>{e.preventDefault();localStorage.setItem(key,JSON.stringify({necessary:true,analytics:a.checked,preferences:p.checked,marketing:m.checked}));s.textContent='आपकी कुकी पसंद सहेज ली गई है। विश्लेषण सेटिंग लागू करने के लिए पृष्ठ पुनः लोड करें।'});document.getElementById('reject').addEventListener('click',()=>{a.checked=p.checked=m.checked=false;localStorage.setItem(key,JSON.stringify({necessary:true,analytics:false,preferences:false,marketing:false}));s.textContent='सभी वैकल्पिक कुकी अस्वीकार कर दी गई हैं।'});`}</script></Base>
