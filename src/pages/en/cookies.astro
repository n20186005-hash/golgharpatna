---
import Base from '../../layouts/Base.astro';
const title='Cookie and analytics settings | Golghar Patna';const description='Save or withdraw your Google Analytics choice; see the status when local storage fails.';
---
<Base {title} {description} lang="en" altPath="cookies" robots="noindex,follow"><section class="section"><div class="shell legal max-w-4xl"><p class="eyebrow">Privacy controls</p><h1 class="section-title mt-3">Cookie and analytics settings</h1><p class="mt-4">Reviewed: 23 October 2026. This control is for this site’s Google Analytics. The weather cache and offline copies are local features; you can remove them in your browser’s site-data settings. The host’s technical services are separate.</p><form id="cookie-form" class="mt-8 grid gap-4"><label class="card flex items-center justify-between gap-5 p-6"><span><strong>Google Analytics</strong><small class="block muted">Measurement identity G-HXM22WWPKP. Turning it on contacts Google’s service.</small></span><input id="analytics" type="checkbox" class="size-5"/></label><div class="flex flex-wrap gap-3"><button type="submit" class="btn btn-primary">Save choice</button><button id="reject" type="button" class="btn btn-ghost">Turn analytics off</button></div><p id="status" class="font-bold" role="status" aria-live="polite"></p></form><p class="mt-6"><a href="/en/privacy/">Privacy and service providers</a></p></div></section>
<script is:inline>
(()=>{const api=window.golgharAnalytics,form=document.getElementById('cookie-form'),box=document.getElementById('analytics'),status=document.getElementById('status'),reject=document.getElementById('reject');if(!api||!form||!box||!status||!reject)return;let limited=false;const sync=()=>box.checked=api.get();sync();const save=allow=>{const r=api.set(allow);limited=!r.saved&&!r.sharedOff;sync();status.textContent=r.saved?(r.effective?'Analytics is on. Your choice was saved and verified in this browser.':'Analytics is off. Your choice was saved and verified in this browser.'):(r.sharedOff?'Your choice could not be saved to turn it on. Analytics is off.':'Analytics is off on this page. The change to storage could not be confirmed; another page or your next visit may read the earlier permission.');};form.addEventListener('submit',e=>{e.preventDefault();save(box.checked)});reject.addEventListener('click',()=>save(false));window.addEventListener('storage',()=>{sync();if(!limited)status.textContent=api.get()?'Analytics is on according to the stored choice.':'Analytics is off on this page.';});})();
</script></Base>
