---
import Base from '../layouts/Base.astro';
import Weather from '../components/Weather.astro';

const title = 'गोलघर पटना (Golghar Patna) — Ticket Price, Timings, History & Location';
const description = 'पटना के ऐतिहासिक गोलघर (Golghar) की मुफ़्त यात्रा जानकारी: प्रवेश निःशुल्क, समय 9:00–18:00, 145 सीढ़ियाँ, 1786 का इतिहास, कहाँ स्थित है और वहाँ कैसे पहुँचें—स्वतंत्र हिंदी मार्गदर्शिका।';

const site = Astro.site;
const pageUrl = site ? new URL('/', site).toString() : undefined;
const SITE_NAME = 'गोलघर पटना यात्रा मार्गदर्शिका';
const MAPS_URL = 'https://maps.app.goo.gl/QowA7WfKUocCjCgH8';
const heroImage = site ? new URL('/images/golghar-hero.jpg', site).toString() : '/images/golghar-hero.jpg';

const attraction: any = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "@id": pageUrl ? pageUrl + '#attraction' : undefined,
  "name": "गोलघर (Golghar)",
  "alternateName": ["Gol Ghar", "गोल घर", "Golghar Patna", "पटना का गोलघर"],
  "description": description,
  "url": pageUrl,
  "image": [heroImage],
  "isAccessibleForFree": true,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Opp. Govt. Girls High School, Ashok Rajpath Road",
    "addressLocality": "Patna",
    "addressRegion": "Bihar",
    "postalCode": "800001",
    "addressCountry": "IN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 25.62033697744103, "longitude": 85.13687307717692 },
  "hasMap": MAPS_URL,
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "09:00", "closes": "18:00"
  }],
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.2", "reviewCount": "24468" },
  "sameAs": [
    "https://tourism.bihar.gov.in/hi/destinations/patna/gol-ghar",
    "https://patna.nic.in/tourist-place/gol-ghar/",
    MAPS_URL
  ]
};

// साइट-स्तरीय E-E-A-T नोड्स
const org = pageUrl ? {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": pageUrl + '#organization',
  "name": SITE_NAME,
  "url": pageUrl,
  "logo": site ? new URL('/favicon/favicon.svg', site).toString() : undefined
} : undefined;

const website = pageUrl ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": pageUrl + '#website',
  "url": pageUrl,
  "name": SITE_NAME,
  "inLanguage": "hi-IN",
  "publisher": { "@id": pageUrl + '#organization' }
} : undefined;

const webpage = pageUrl ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl + '#webpage',
  "url": pageUrl,
  "name": title,
  "description": description,
  "inLanguage": "hi-IN",
  "datePublished": "2026-09-03",
  "dateModified": "2026-09-03",
  "isPartOf": { "@id": pageUrl + '#website' },
  "about": { "@id": pageUrl + '#attraction' },
  "primaryImageOfPage": heroImage
} : undefined;

// भौगोलिक पदानुक्रम (संरचित ब्रेडक्रंब — टेम्पलेट §4.2)
const breadcrumb = pageUrl ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "गोलघर पटना यात्रा मार्गदर्शिका",
      "item": pageUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "गोलघर (Golghar), पटना, बिहार, भारत"
    }
  ]
} : undefined;

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question", "name": "गोलघर पटना कहाँ स्थित है?",
      "acceptedAnswer": { "@type": "Answer", "text": "गोलघर पटना के मध्य भाग में, गांधी मैदान के पश्चिम और अशोक राजपथ क्षेत्र के पास स्थित है। पता: Opp. Govt. Girls High School, Ashok Rajpath Rd, Patna, Bihar 800001 (प्लस कोड J4CQ+4Q); गांधी मैदान से यह लगभग 1–1.5 किमी है।" }
    },
    {
      "@type": "Question", "name": "गोलघर पटना का प्रवेश शुल्क कितना है?",
      "acceptedAnswer": { "@type": "Answer", "text": "बिहार पर्यटन की पटना सूची के अनुसार गोलघर का प्रवेश निःशुल्क (Free) है। विशेष कार्यक्रम या सुविधा के अलग शुल्क हो सकते हैं; यात्रा से पहले नवीनतम स्थानीय व्यवस्था की पुष्टि करें।" }
    },
    {
      "@type": "Question", "name": "गोलघर का खुलने का समय (टाइमिंग) क्या है?",
      "acceptedAnswer": { "@type": "Answer", "text": "बिहार पर्यटन की जानकारी के अनुसार गोलघर सोमवार से रविवार सुबह 9:00 बजे से शाम 6:00 बजे तक खुला रहता है। संचालन या मरम्मत के कारण समय बदल सकता है, इसलिए स्थल पर नवीनतम सूचना देखें।" }
    },
    {
      "@type": "Question", "name": "गोलघर कब और किसने बनवाया था?",
      "acceptedAnswer": { "@type": "Answer", "text": "गोलघर का निर्माण 1786 में पूरा हुआ था; यह ब्रिटिश ईस्ट इंडिया कंपनी के इंजीनियर कैप्टन जॉन गार्स्टिन (बंगाल इंजीनियर्स) के निर्देशन में बनाया गया था।" }
    },
    {
      "@type": "Question", "name": "गोलघर क्यों बनाया गया था?",
      "acceptedAnswer": { "@type": "Answer", "text": "गोलघर सेना व प्रशासन के लिए अनाज भंडारण हेतु बनाया गया था। आधार पर खुदे अभिलेख के अनुसार यह कई अनाजगृहों की योजना का पहला भवन था, जो अकाल की रोकथाम की समग्र योजना का हिस्सा था; बाद के भवन कभी नहीं बन सके।" }
    },
    {
      "@type": "Question", "name": "गोलघर में कितनी सीढ़ियाँ हैं?",
      "acceptedAnswer": { "@type": "Answer", "text": "बिहार पर्यटन के अनुसार बाहरी घुमावदार सीढ़ी में 145 सीढ़ियाँ हैं। दोनों ओर की सीढ़ियाँ अनाज ढोने वाले श्रमिकों के आने-जाने के लिए बनाई गई थीं।" }
    },
    {
      "@type": "Question", "name": "गोलघर की ऊँचाई और दीवारें कितनी हैं?",
      "acceptedAnswer": { "@type": "Answer", "text": "गोलघर लगभग 29 मीटर ऊँचा है और आधार पर इसकी दीवार लगभग 3.6 मीटर मोटी है। यह स्तंभ-रहित, खोखले गुंबद जैसी संरचना है।" }
    },
    {
      "@type": "Question", "name": "क्या गोलघर का प्रवेश शुल्क है?",
      "acceptedAnswer": { "@type": "Answer", "text": "बिहार पर्यटन की पटना सूची में गोलघर के लिए प्रवेश निःशुल्क दिखाया गया है। यात्रा से पहले नवीनतम स्थानीय व्यवस्था की पुष्टि करें।" }
    },
    {
      "@type": "Question", "name": "क्या ऊपर तक जाना हमेशा संभव है?",
      "acceptedAnswer": { "@type": "Answer", "text": "सीढ़ियों या ऊपरी भाग की पहुँच सुरक्षा, रखरखाव या स्थानीय निर्देश के कारण बदल सकती है। स्थल पर नवीनतम सूचना देखें।" }
    },
    {
      "@type": "Question", "name": "क्या कैमरा और इलेक्ट्रॉनिक गैजेट ले जा सकते हैं?",
      "acceptedAnswer": { "@type": "Answer", "text": "बिहार पर्यटन की आधिकारिक जानकारी में मोबाइल, कैमरा और इलेक्ट्रॉनिक गैजेट्स की अनुमति बताई गई है; स्थानीय सुरक्षा निर्देश लागू रहेंगे।" }
    },
    {
      "@type": "Question", "name": "क्या पास में खाने, पार्किंग या एटीएम की सुविधा है?",
      "acceptedAnswer": { "@type": "Answer", "text": "आस-पास कैफे-रेस्तरां, सड़क पार्किंग, दुकानें और एटीएम जैसी सामान्य सुविधाएँ मिल सकती हैं। यह एक गैर-लाभकारी सूचना साइट है, इसलिए हम किसी विशेष प्रतिष्ठान की अनुशंसा नहीं करते।" }
    }
  ]
};
---
<Base {title} {description} schema={[attraction, org, website, webpage, breadcrumb, faq].filter(Boolean)}>

  <!-- ============ Hero ============ -->
  <section class="relative overflow-hidden bg-[#201f1a] text-white">
    <div class="absolute inset-0 opacity-35">
      <img src="/images/golghar-hero.jpg" alt="गोलघर (Golghar) का मुख्य दृश्य – पटना, बिहार, भारत" class="photo" loading="eager" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-transparent"></div>
    <div class="shell relative grid min-h-[680px] items-end gap-10 py-20 lg:grid-cols-[1.05fr_.75fr]">
      <div>
        <h1 class="mt-4 max-w-4xl text-6xl font-black leading-[.95] tracking-[-.06em] md:text-8xl">गोलघर<span class="mt-2 block text-3xl font-extrabold tracking-tight text-[#e7c785] md:text-5xl">पटना · बिहार · भारत</span></h1>
        <p class="mt-5 max-w-2xl text-xl text-stone-200">1786 का विशाल, स्तंभ-रहित अनाजघर—अपनी अर्धगोलाकार देह और बाहरी घुमावदार सीढ़ियों के कारण पटना की सबसे पहचानने योग्य ऐतिहासिक आकृतियों में से एक।</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#यात्रा" class="btn bg-[#c69b54] text-[#1d241f]">यात्रा की योजना</a>
          <a href="https://tourism.bihar.gov.in/hi/destinations/patna/gol-ghar" target="_blank" rel="noopener" class="btn btn-ghost">बिहार पर्यटन</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">1786</strong><span class="block text-sm text-stone-300">निर्माण वर्ष</span></div>
        <div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">29 मी.</strong><span class="block text-sm text-stone-300">लगभग ऊँचाई</span></div>
        <div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">145</strong><span class="block text-sm text-stone-300">घुमावदार सीढ़ियाँ</span></div>
        <div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">3.6 मी.</strong><span class="block text-sm text-stone-300">आधार की दीवार</span></div>
      </div>
    </div>
  </section>

  <!-- ============ भौगोलिक पदानुक्रम (ब्रेडक्रंब) ============ -->
  <nav aria-label="स्थान पदानुक्रम" class="border-b border-stone-200 bg-[#fffaf2]">
    <div class="shell flex flex-wrap items-center gap-2 py-3 text-sm text-stone-600">
      <span class="font-black text-[#1d241f]">गोलघर (Golghar)</span>
      <span aria-hidden="true" class="text-stone-400">→</span>
      <span>पटना</span>
      <span aria-hidden="true" class="text-stone-400">→</span>
      <span>बिहार</span>
      <span aria-hidden="true" class="text-stone-400">→</span>
      <span>भारत</span>
    </div>
  </nav>

  <!-- ============ इतिहास ============ -->
  <section id="इतिहास" class="section">
    <div class="shell grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">वास्तु और इतिहास</p>
        <h2 class="section-title mt-3">एक अनाजघर जो पटना का प्रतीक बन गया</h2>
        <p class="mt-6 text-lg text-stone-700">1770 के अकाल के बाद खाद्यान्न भंडारण की योजना के हिस्से के रूप में ब्रिटिश इंजीनियर कैप्टन जॉन गार्स्टिन ने गोलघर बनवाया। बिहार पर्यटन इसे 1786 में निर्मित विशाल स्तंभ-रहित संरचना बताता है। इसकी बाहरी दोहरी घुमावदार सीढ़ियाँ ऊपर तक जाती हैं और मूलतः अनाज ढोने वाले श्रमिकों के आवागमन के लिए बनाई गई थीं।</p>
        <p class="mt-4 text-stone-600">यह स्थल गांधी मैदान के पश्चिम में, अशोक राजपथ क्षेत्र के पास है और गंगा नदी के निकट स्थित है—इसी भूगोल को पृष्ठ शीर्षक, संरचित डेटा और आधिकारिक संदर्भ लिंक में स्पष्ट रखा गया है।</p>
        <p class="mt-4 text-stone-600">आधार पर खुदे अभिलेख के अनुसार यह भवन ऐसे कई विशाल अनाजगृहों की शृंखला का <strong>पहला भवन</strong> था—यह योजना "इन प्रांतों में अकाल की स्थायी रोकथाम" के व्यापक उद्देश्य से जुड़ी थी। बाद के अनाजगृह कभी नहीं बन सके, इसलिए आज यह विशाल गुंबद अपनी तरह का एकमात्र खड़ा उदाहरण है। निर्माण 20 जुलाई 1786 को पूरा हुआ माना जाता है।</p>
        <div class="mt-8 space-y-5">
          <div class="flex gap-4">
            <span class="mt-1 inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1d241f] font-black text-[#e7c785]">1</span>
            <div><strong class="block">अकाल का सबक (1770 के दशक की पृष्ठभूमि)</strong><p class="muted">क्षेत्र में भीषण अकाल के बाद खाद्यान्न भंडारण की आवश्यकता महसूस की गई; गोलघर उसी सोच का ठोस नतीजा था।</p></div>
          </div>
          <div class="flex gap-4">
            <span class="mt-1 inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1d241f] font-black text-[#e7c785]">2</span>
            <div><strong class="block">1786 — कैप्टन जॉन गार्स्टिन</strong><p class="muted">ईस्ट इंडिया कंपनी के बंगाल इंजीनियर्स के इंजीनियर गार्स्टिन ने इसका डिज़ाइन व निर्माण कराया; बीहाइव (छत्ते) जैसी आकृति वाला यह विशाल गोदाम बना।</p></div>
          </div>
          <div class="flex gap-4">
            <span class="mt-1 inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1d241f] font-black text-[#e7c785]">3</span>
            <div><strong class="block">"श्रृंखला का पहला" — बाकी कभी नहीं बने</strong><p class="muted">मूल योजना में ऐसे कई गोलघर थे, पर केवल यही एक बन सका। गोलघर आज उस योजना का अकेला स्मारक है।</p></div>
          </div>
          <div class="flex gap-4">
            <span class="mt-1 inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1d241f] font-black text-[#e7c785]">4</span>
            <div><strong class="block">आज — पटना का सांस्कृतिक चिह्न</strong><p class="muted">समय-समय पर संरक्षण/सुधार कार्य होते रहे (2002 व 2018 की रिपोर्टें)। आज यह बिहार सरकार के अधीन एक प्रमुख पर्यटन स्थल है।</p></div>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-6">
        <div class="photo-card h-[420px]">
          <img src="/images/golghar-stairs.jpg" alt="गोलघर (Golghar) की बाहरी घुमावदार सीढ़ियाँ – पटना, बिहार, भारत" class="photo" loading="lazy" />
        </div>
        <div class="rounded-3xl border border-[#8f4e36]/20 bg-[#fffaf2] p-6 text-sm text-stone-600">
          <strong class="block text-[#1d241f]">एक नज़र में</strong>
          गोलघर का भीतरी भाग स्तंभ-रहित खोखला गुंबद है; पर्यटक मुख्यतः बाहरी सीढ़ियों से ऊपर चढ़कर पटना नगर और गंगा का विहंगम दृश्य देखते हैं। सीढ़ियों/भीतरी भाग तक पहुँच स्थानीय व्यवस्था के अनुसार बदल सकती है।
        </div>
      </div>
    </div>
  </section>

  <!-- ============ वास्तुकला ============ -->
  <section id="वास्तुकला" class="section bg-[#e9dfd0]">
    <div class="shell">
      <p class="eyebrow">वास्तुकला</p>
      <h2 class="section-title mt-3 max-w-3xl">गुंबद, सीढ़ियाँ और इंजीनियरिंग के किस्से</h2>
