---
import Base from '../layouts/Base.astro';
import Weather from '../components/Weather.astro';
const title='गोलघर पटना: समय, टिकट जानकारी, इतिहास और कहाँ है';
const description='गोलघर पटना कहाँ है, दिनांकित समय-सारणी, टिकट की पुष्टि, 1786 का इतिहास और यात्रा की तैयारी। स्वतंत्र हिंदी मार्गदर्शिका; वर्तमान पहुँच स्थानीय निर्देश से जाँचें।';
const origin='https://golgharpatna.com';
const faqItems=[{"q": "गोलघर पटना कहाँ है?", "a": "गोलघर पटना, बिहार में अशोक राजपथ रोड क्षेत्र में है। मानचित्र का पता: गवर्नमेंट गर्ल्स हाई स्कूल के सामने, पटना, बिहार 800001। स्थान का संदर्भ बिंदु 25.620337, 85.139448 है; यह पार्किंग या प्रवेश-द्वार की गारंटी नहीं है।"}, {"q": "गोलघर का समय और साप्ताहिक अवकाश क्या है?", "a": "23 अक्टूबर 2026 को देखे गए Google Maps विवरण में मंगलवार से रविवार सुबह 09:00 से शाम 17:00 और सोमवार बंद दिखाया गया। यह तृतीय-पक्ष सूची का दिनांकित विवरण है, संचालन की लाइव पुष्टि नहीं। यात्रा से पहले स्थल या आधिकारिक पर्यटन सूचना से समय और पहुँच जाँचें।"}, {"q": "गोलघर का टिकट कितना है?", "a": "इस समीक्षा में वर्तमान आधिकारिक टिकट-दर की पुष्टि नहीं हो सकी। पुराने स्रोत-पाठ के निःशुल्क प्रवेश दावे को आज की गारंटी न मानें। परिसर, सीढ़ियों, कार्यक्रम या किसी अलग सुविधा के लागू शुल्क स्थल पर जाँचें। यह साइट टिकट नहीं बेचती।"}, {"q": "गोलघर किसने और कब बनवाया?", "a": "पटना जिला प्रशासन के इतिहास विवरण के अनुसार कैप्टन जॉन गार्स्टिन ने ब्रिटिश सेना के लिए 1786 में यह अनाजघर बनाया था। यह 1770 के अकाल के बाद की खाद्यान्न-भंडारण योजना से जुड़ा था।"}, {"q": "गोलघर में कितनी सीढ़ियाँ हैं?", "a": "पटना जिला प्रशासन 145 घुमावदार सीढ़ियों का उल्लेख करता है। यह वास्तु का ऐतिहासिक विवरण है, ऊपर चढ़ने की वर्तमान अनुमति नहीं। प्रवेश और सीढ़ियों की स्थिति स्थानीय निर्देश से जाँचें।"}, {"q": "गोलघर कितना ऊँचा है?", "a": "जिला प्रशासन के विवरण में ऊँचाई लगभग 29 मीटर और आधार पर दीवार की मोटाई लगभग 3.6 मीटर बताई गई है। भवन स्तंभ-रहित अनाजघर के रूप में वर्णित है।"}, {"q": "क्या मौसम देखकर सीढ़ियाँ खुली होने का पता चलता है?", "a": "नहीं। मौसम प्रदाता का पूर्वानुमान स्थल की अनुमति, सुरक्षा निरीक्षण या सीढ़ियों की उपलब्धता की पुष्टि नहीं करता। स्थानीय निर्देश और संकेतों को प्राथमिकता दें।"}];
const sections=[["इतिहास", "1786 का अनाजघर और पटना की स्मृति", "पटना जिला प्रशासन के अनुसार गोलघर 1770 के अकाल के बाद खाद्यान्न भंडारण के उद्देश्य से बनाया गया था। कैप्टन जॉन गार्स्टिन ने 1786 में ब्रिटिश सेना के लिए इसका निर्माण किया। प्रशासन के इतिहास पृष्ठ का अंतिम अद्यतन 24 अगस्त 2024 दिखता है; इस ऐतिहासिक विवरण को आज की संचालन-सूचना से अलग समझें।"], ["वास्तुकला", "गुंबद और घुमावदार सीढ़ियाँ", "जिला प्रशासन गोलघर को स्तंभ-रहित संरचना बताता है। लगभग 29 मीटर ऊँचाई, आधार पर लगभग 3.6 मीटर मोटी दीवार और 145 सीढ़ियाँ इसकी पहचान हैं। सीढ़ियों का ऐतिहासिक उपयोग ऊपर से अनाज पहुँचाने और दूसरी ओर से उतरने के लिए था। पुराना विवरण आज ऊपर चढ़ने की अनुमति की गारंटी नहीं है।"], ["यात्रा", "समय, टिकट और पहुँच पहले जाँचें", "Google Maps की 23 अक्टूबर 2026 की सूची में मंगलवार–रविवार 09:00–17:00 और सोमवार बंद है। इस सूची को आधिकारिक आदेश या लाइव स्थिति न मानें। वर्तमान प्रवेश शुल्क, कार्यक्रम और ऊपरी भाग की पहुँच की पुष्टि इस समीक्षा में नहीं हुई; स्थल के निर्देश देखें।"], ["सुविधाएँ", "अपनी जरूरतों के अनुसार तैयारी", "पानी और मौसम के अनुकूल वस्त्र रखें। शौचालय, बैठने की जगह, व्हीलचेयर-अनुकूल पहुँच या अन्य सुविधा की उपलब्धता पहले जाँचें; यह मार्गदर्शिका इनकी वर्तमान उपलब्धता प्रमाणित नहीं करती। बच्चों के साथ उपलब्ध, अनुमति वाले मार्ग पर रहें और सीढ़ियों पर स्थानीय सुरक्षा निर्देश मानें।"], ["परिवहन", "स्थान और आने-जाने की योजना", "संदर्भ पता गवर्नमेंट गर्ल्स हाई स्कूल के सामने, अशोक राजपथ रोड, पटना 800001 है। प्रस्थान स्थल के अनुसार मानचित्र में रास्ता चुनें। सार्वजनिक परिवहन की लाइन, किराया और पड़ाव वर्तमान सेवा से जाँचें। वाहन से आने पर अधिकृत पार्किंग और स्थानीय संकेत देखें; यात्रा या पैदल चलने का निश्चित समय यहाँ नहीं दिया जाता।"], ["यात्रा-योजना", "एक लचीला शहरी भ्रमण", "अपने समय, चलने की क्षमता और मौसम के अनुसार गोलघर को पटना भ्रमण में शामिल करें। आने-जाने और विश्राम के लिए समय रखें। परिसर, सीढ़ियों और आसपास के स्थलों की प्रवेश-शर्तें अलग हो सकती हैं। बिना पुष्टि ऊपर जाने या किसी सेवा के उपलब्ध होने पर योजना निर्भर न रखें।"], ["आसपास", "पटना के अन्य स्थलों के साथ जोड़ना", "जिला प्रशासन का पर्यटन पृष्ठ पटना में अन्य दर्शनीय स्थलों की जानकारी देता है। अपने शुरुआती स्थान और गति के अनुसार अलग-अलग यात्राएँ जोड़ें; गोलघर से हर स्थान तक कम दूरी या तय पैदल समय का अनुमान न लगाएँ। प्रत्येक स्थान का समय और टिकट अलग से जाँचें।"], ["जिम्मेदारी", "स्वतंत्र सूचना, आधिकारिक संचालन नहीं", "यह स्वतंत्र हिंदी यात्रा मार्गदर्शिका है। यह गोलघर, पटना जिला प्रशासन या बिहार पर्यटन का आधिकारिक प्रतिनिधि नहीं है। मानचित्र की सार्वजनिक रेटिंग तीसरे पक्ष की है। जानकारी और पूर्वानुमान बदल सकते हैं; स्थल के वर्तमान निर्देश प्राथमिक हैं।"]];
const schema=[{'@context':'https://schema.org','@type':'TouristAttraction','@id':origin+'/#attraction',name:'गोलघर, पटना',alternateName:['Golghar Patna','Gol Ghar'],url:origin+'/',description,geo:{'@type':'GeoCoordinates',latitude:25.620337,longitude:85.139448},address:{'@type':'PostalAddress',streetAddress:'Opp. Govt. Girls High School, Ashok Rajpath Road',addressLocality:'Patna',addressRegion:'Bihar',postalCode:'800001',addressCountry:'IN'},hasMap:'https://maps.app.goo.gl/QowA7WfKUocCjCgH8'}, {'@context':'https://schema.org','@type':'WebSite','@id':origin+'/#website',url:origin+'/',name:'गोलघर पटना यात्रा मार्गदर्शिका',inLanguage:'hi-IN'}, {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqItems.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}];
---
<Base {title} {description} {schema}>
<section class="relative overflow-hidden bg-[#201f1a] text-white"><div class="absolute inset-0 opacity-45"><img class="photo" src="/images/golghar-hero.svg" alt="गोलघर का मूल वैचारिक रेखाचित्र, वास्तविक फोटो नहीं" width="1200" height="800" fetchpriority="high"/></div><div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-transparent"></div><div class="shell relative grid min-h-[640px] items-end gap-10 py-20 lg:grid-cols-[1.1fr_.8fr]"><div><p class="text-sm font-bold text-[#e7c785]">पटना · बिहार · स्वतंत्र हिंदी मार्गदर्शिका</p><h1 class="mt-4 text-6xl font-black leading-tight md:text-8xl">गोलघर पटना</h1><p class="mt-6 max-w-2xl text-xl text-stone-200">1786 का ऐतिहासिक अनाजघर—स्थान, इतिहास और यात्रा की तैयारी समझें। समय, शुल्क और ऊपर जाने की अनुमति पहले जाँचें।</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn hero-light" href="#यात्रा">यात्रा की जानकारी</a><a class="btn btn-ghost" href="https://maps.app.goo.gl/QowA7WfKUocCjCgH8" target="_blank" rel="noopener noreferrer">मानचित्र खोलें</a></div><p class="mt-6 text-xs text-stone-200">चित्र: मूल सांकेतिक रेखाचित्र; वास्तविक फोटो या मापचित्र नहीं।</p></div><div class="grid grid-cols-2 gap-4"><div class="rounded-3xl bg-white/10 p-5"><strong class="text-3xl">1786</strong><span class="block">निर्माण का वर्ष</span></div><div class="rounded-3xl bg-white/10 p-5"><strong class="text-3xl">145</strong><span class="block">ऐतिहासिक सीढ़ियों का विवरण</span></div><div class="rounded-3xl bg-white/10 p-5"><strong class="text-3xl">29 मी.</strong><span class="block">लगभग ऊँचाई</span></div><div class="rounded-3xl bg-white/10 p-5"><strong class="text-xl">4.2 / 5</strong><span class="block text-sm">Google Maps · 24,544 समीक्षाएँ · 23/10/2026</span></div></div></div></section>
{sections.map(([id,heading,text],i)=><section id={id} class={'section '+(i%2?'bg-[#e9dfd0]':'')}><div class="shell grid gap-9 lg:grid-cols-[1.1fr_.8fr]"><article><p class="eyebrow">गोलघर यात्रा मार्गदर्शिका</p><h2 class="section-title mt-3">{heading}</h2><p class="mt-6 text-lg text-stone-700">{text}</p>{id==='परिवहन'&&<p class="mt-4"><span>स्थान बिंदु: </span><bdi dir="ltr">25.620337, 85.139448</bdi><a class="ml-3 underline" href="https://maps.app.goo.gl/QowA7WfKUocCjCgH8">मानचित्र में देखें</a></p>}{id==='परिवहन'&&<iframe class="map-frame mt-6" title="गोलघर पटना का मानचित्र" src="https://maps.google.com/maps?q=25.620337,85.139448&amp;z=16&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>}{id==='इतिहास'&&<p class="mt-4"><a class="underline" href="https://patna.nic.in/tourist-place/gol-ghar/">पटना जिला प्रशासन — गोलघर का इतिहास</a></p>}</article><figure class="card overflow-hidden"><img src={'/images/golghar-'+(i%2?'stairs':'wide')+'.svg'} alt="गोलघर की आकृति का मूल वैचारिक चित्र, फोटो नहीं" width="1200" height="800" loading="lazy" class="w-full"/><figcaption class="p-4 text-xs muted">मूल सांकेतिक चित्र; वास्तु का सटीक मापचित्र या वर्तमान दृश्य नहीं।</figcaption></figure></div></section>)}
<div id="मौसम-रणनीति"><Weather/></div>
<section id="faq" class="section"><div class="shell max-w-4xl"><p class="eyebrow">अक्सर पूछे जाने वाले प्रश्न</p><h2 class="section-title mt-3">गोलघर की यात्रा से पहले</h2><div class="mt-8 divide-y divide-stone-300">{faqItems.map(({q,a})=><details class="py-5"><summary class="cursor-pointer text-lg font-bold">{q}</summary><p class="mt-3 text-stone-700">{a}</p></details>)}</div></div></section>
<section class="section bg-[#e9dfd0]"><div class="shell legal"><h2>स्रोत और समीक्षा</h2><p>समीक्षा: 23 अक्टूबर 2026। इतिहास: <a href="https://patna.nic.in/tourist-place/gol-ghar/">पटना जिला प्रशासन</a>। समय और सार्वजनिक रेटिंग: <a href="https://maps.app.goo.gl/QowA7WfKUocCjCgH8">दिनांकित Google Maps सूची</a>। वर्तमान पर्यटन सूचना: <a href="https://tourism.bihar.gov.in/">बिहार पर्यटन</a>। अंतिम लिंक आधिकारिक सूचना का प्रवेश-बिंदु है; यहाँ आज की टिकट-दर या ऊपरी भाग की अनुमति पुष्ट नहीं है।</p><p>सभी तीन चित्र इस मार्गदर्शिका के मूल SVG रेखाचित्र हैं। पहले प्रयुक्त फोटो की वर्तमान पहचान और लाइसेंस की पुष्टि न होने पर उन्हें हटाया गया है।</p><p><a href="/cookies/">विश्लेषण की पसंद</a> · <a href="/privacy/">गोपनीयता</a> · <a href="/terms/">उपयोग की शर्तें</a></p></div></section>
</Base>
