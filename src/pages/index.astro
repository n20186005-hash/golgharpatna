---
import Base from '../layouts/Base.astro';
const title='गोलघर पटना | इतिहास, यात्रा, समय, प्रवेश और स्थानीय मार्गदर्शिका';
const description='पटना के ऐतिहासिक गोलघर के इतिहास, 145 सीढ़ियों, 29 मीटर ऊँचाई, यात्रा समय, प्रवेश, परिवहन, भोजन, पार्किंग और आसपास के दर्शनीय स्थलों की स्वतंत्र हिंदी मार्गदर्शिका।';
const site = Astro.site;
const pageUrl = site ? new URL('/', site).toString() : undefined;
const attraction:any={"@context":"https://schema.org","@type":"TouristAttraction","name":"गोलघर (Golghar)","alternateName":["Gol Ghar","गोल घर"],"description":description,"address":{"@type":"PostalAddress","streetAddress":"Opp. Govt. Girls High School, Ashok Rajpath Road","addressLocality":"Patna","addressRegion":"Bihar","postalCode":"800001","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":25.62033697744103,"longitude":85.13687307717692},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"09:00","closes":"18:00"}],"isAccessibleForFree":true,"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.2","reviewCount":"24468"},"sameAs":["https://tourism.bihar.gov.in/hi/destinations/patna/gol-ghar","https://patna.nic.in/tourist-place/gol-ghar/","https://maps.app.goo.gl/QowA7WfKUocCjCgH8"]}; if(pageUrl) attraction.url=pageUrl;
const faq={"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"गोलघर कब बना था?","acceptedAnswer":{"@type":"Answer","text":"गोलघर का निर्माण 1786 में कैप्टन जॉन गार्स्टिन द्वारा कराया गया था।"}},{"@type":"Question","name":"गोलघर में कितनी सीढ़ियाँ हैं?","acceptedAnswer":{"@type":"Answer","text":"बिहार पर्यटन के अनुसार बाहरी घुमावदार सीढ़ी में 145 सीढ़ियाँ हैं।"}},{"@type":"Question","name":"गोलघर की ऊँचाई कितनी है?","acceptedAnswer":{"@type":"Answer","text":"गोलघर लगभग 29 मीटर ऊँचा है और आधार पर इसकी दीवार लगभग 3.6 मीटर मोटी है।"}},{"@type":"Question","name":"क्या गोलघर का प्रवेश शुल्क है?","acceptedAnswer":{"@type":"Answer","text":"बिहार पर्यटन की पटना सूची में गोलघर के लिए प्रवेश निःशुल्क दिखाया गया है। यात्रा से पहले नवीनतम स्थानीय व्यवस्था की पुष्टि करें।"}}]};
---
<Base {title} {description} schema={[attraction,faq]}>
<section class="relative overflow-hidden bg-[#201f1a] text-white"><div class="absolute inset-0 opacity-35"><img src="/images/golghar-hero.jpg" alt="पटना का गोलघर" class="photo" loading="eager"/></div><div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-transparent"></div><div class="shell relative grid min-h-[680px] items-end gap-10 py-20 lg:grid-cols-[1.05fr_.75fr]"><div><p class="eyebrow !text-[#e7c785]">पटना · बिहार</p><h1 class="mt-4 max-w-4xl text-6xl font-black leading-[.95] tracking-[-.06em] md:text-8xl">गोलघर</h1><p class="mt-5 max-w-2xl text-xl text-stone-200">1786 का विशाल, स्तंभ-रहित अनाजघर—अपनी अर्धगोलाकार देह और बाहरी घुमावदार सीढ़ियों के कारण पटना की सबसे पहचानने योग्य ऐतिहासिक आकृतियों में से एक।</p><div class="mt-8 flex flex-wrap gap-3"><a href="#यात्रा" class="btn bg-[#c69b54] text-[#1d241f]">यात्रा की योजना</a><a href="https://tourism.bihar.gov.in/hi/destinations/patna/gol-ghar" target="_blank" rel="noopener" class="btn btn-ghost">बिहार पर्यटन</a></div></div><div class="grid grid-cols-2 gap-3"><div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">1786</strong><span class="block text-sm text-stone-300">निर्माण वर्ष</span></div><div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">29 मी.</strong><span class="block text-sm text-stone-300">लगभग ऊँचाई</span></div><div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">145</strong><span class="block text-sm text-stone-300">घुमावदार सीढ़ियाँ</span></div><div class="rounded-3xl bg-white/10 p-5 backdrop-blur"><strong class="text-3xl">3.6 मी.</strong><span class="block text-sm text-stone-300">आधार की दीवार</span></div></div></div></section>
<section id="इतिहास" class="section"><div class="shell grid gap-12 lg:grid-cols-2"><div><p class="eyebrow">वास्तु और इतिहास</p><h2 class="section-title mt-3">एक अनाजघर जो पटना का प्रतीक बन गया</h2><p class="mt-6 text-lg text-stone-700">1770 के अकाल के बाद खाद्यान्न भंडारण की योजना के हिस्से के रूप में ब्रिटिश इंजीनियर कैप्टन जॉन गार्स्टिन ने गोलघर बनवाया। बिहार पर्यटन इसे 1786 में निर्मित विशाल स्तंभ-रहित संरचना बताता है। इसकी बाहरी दोहरी घुमावदार सीढ़ियाँ ऊपर तक जाती हैं और मूलतः अनाज ढोने वाले श्रमिकों के आवागमन के लिए बनाई गई थीं।</p><p class="mt-4 text-stone-600">यह स्थल गांधी मैदान के पश्चिम में, अशोक राजपथ क्षेत्र के पास है और गंगा नदी के निकट स्थित है—इसी भूगोल को पृष्ठ शीर्षक, संरचित डेटा और आधिकारिक संदर्भ लिंक में स्पष्ट रखा गया है।</p></div><div class="photo-card h-[420px]"><img src="/images/golghar-stairs.jpg" alt="गोलघर की बाहरी घुमावदार सीढ़ियाँ" class="photo" loading="lazy"/></div></div></section>
<section id="यात्रा" class="section bg-[#e9dfd0]"><div class="shell"><p class="eyebrow">यात्रा जानकारी</p><h2 class="section-title mt-3">आने से पहले जरूरी बातें</h2><div class="grid-auto mt-8"><article class="card p-6"><h3 class="text-xl font-black">समय</h3><p class="mt-2 muted">बिहार पर्यटन की पटना सूची में 9:00–18:00 दिया गया है। स्थल पर संचालन/मरम्मत के कारण पहुँच बदल सकती है।</p></article><article class="card p-6"><h3 class="text-xl font-black">प्रवेश / शुल्क</h3><p class="mt-2 muted">बिहार पर्यटन सूची के अनुसार प्रवेश निःशुल्क है। किसी विशेष कार्यक्रम या सुविधा के शुल्क अलग हो सकते हैं।</p></article><article class="card p-6"><h3 class="text-xl font-black">सर्वोत्तम समय</h3><p class="mt-2 muted">सितंबर से अप्रैल अपेक्षाकृत आरामदायक। गर्मियों में सुबह या देर दोपहर बेहतर रहती है।</p></article><article class="card p-6"><h3 class="text-xl font-black">रुकने का समय</h3><p class="mt-2 muted">सामान्यतः 45–90 मिनट पर्याप्त हैं; फोटोग्राफी और आसपास पैदल घूमने पर अधिक समय रखें।</p></article><article class="card p-6"><h3 class="text-xl font-black">पार्किंग</h3><p class="mt-2 muted">स्थल के आसपास सड़क और सार्वजनिक पार्किंग सीमित हो सकती है। व्यस्त समय में टैक्सी/ऑटो अधिक सरल विकल्प है।</p></article><article class="card p-6"><h3 class="text-xl font-black">पता</h3><p class="mt-2 muted">Opp. Govt. Girls High School, Ashok Rajpath Rd, Patna, Bihar 800001 · J4CQ+4Q</p></article></div></div></section>
<section class="section"><div class="shell grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">विस्तृत परिवहन</p><h2 class="section-title mt-3">पटना शहर से कैसे पहुँचें</h2><div class="mt-7 space-y-5 text-stone-700"><p><strong>रेल:</strong> पटना जंक्शन से ऑटो-रिक्शा, टैक्सी या शहर की बस से गांधी मैदान/अशोक राजपथ दिशा में जाएँ।</p><p><strong>हवाई अड्डा:</strong> जयप्रकाश नारायण अंतरराष्ट्रीय हवाई अड्डे से सड़क मार्ग सबसे सीधा विकल्प है; यातायात के लिए अतिरिक्त समय रखें।</p><p><strong>स्थानीय परिवहन:</strong> बिहार पर्यटन केंद्रीय पटना से ऑटो-रिक्शा, सिटी बस और टैक्सी को प्रमुख विकल्प बताता है।</p><p><strong>पैदल:</strong> गांधी मैदान क्षेत्र में हों तो गोलघर को आसपास के संग्रहालयों और नदी क्षेत्र के साथ एक पैदल सर्किट में जोड़ा जा सकता है।</p></div></div><div class="card p-2"><iframe class="map-frame" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6398.742061097016!2d85.13687307717692!3d25.62033697744103!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39ed58504978e8f3%3A0x18cd15ae7d0e6cd!2sGolghar!5e1!3m2!1shi!2sin!4v1788345339487!5m2!1shi!2sin" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="गोलघर पटना का Google मानचित्र"></iframe></div></div></section>
<section id="आसपास" class="section bg-[#1d241f] text-white"><div class="shell"><p class="eyebrow !text-[#e7c785]">आसपास</p><h2 class="section-title mt-3">गोलघर के बाद क्या देखें और क्या खाएँ</h2><div class="mt-8 grid gap-6 lg:grid-cols-2"><div class="rounded-3xl bg-white/7 p-7"><h3 class="text-2xl font-black">आसपास के दर्शनीय स्थल</h3><ul class="mt-4 space-y-3 text-stone-300"><li><strong class="text-white">गांधी मैदान</strong> — केंद्रीय पटना का ऐतिहासिक खुला मैदान।</li><li><strong class="text-white">बिहार संग्रहालय</strong> — बिहार की कला, पुरातत्व और सांस्कृतिक इतिहास के लिए प्रमुख संग्रहालय।</li><li><strong class="text-white">बुद्ध स्मृति पार्क</strong> — पटना जंक्शन के पास आधुनिक बौद्ध स्मृति परिसर।</li><li><strong class="text-white">गांधी घाट</strong> — गंगा किनारे का प्रमुख घाट; शाम के समय लोकप्रिय।</li></ul></div><div class="rounded-3xl bg-white/7 p-7"><h3 class="text-2xl font-black">स्थानीय भोजन</h3><p class="mt-4 text-stone-300">यह सूची स्थानीय स्वाद समझने के लिए है, किसी खास दुकान का व्यावसायिक प्रचार नहीं।</p><div class="mt-5 grid grid-cols-2 gap-3"><span class="rounded-2xl bg-white/8 p-4">लिट्टी–चोखा</span><span class="rounded-2xl bg-white/8 p-4">सत्तू शरबत</span><span class="rounded-2xl bg-white/8 p-4">खाजा</span><span class="rounded-2xl bg-white/8 p-4">दही–चूड़ा</span></div></div></div></div></section>
<section class="section"><div class="shell"><div class="grid gap-5 md:grid-cols-3"><div class="photo-card h-72"><img src="/images/golghar-wide.jpg" alt="पटना में गोलघर का बाहरी दृश्य" class="photo" loading="lazy"/></div><div class="card p-7"><p class="eyebrow">भौगोलिक पहचान</p><h2 class="mt-3 text-3xl font-black">गंगा के पास, गांधी मैदान के पश्चिम</h2><p class="mt-4 muted">Google Maps और आधिकारिक पर्यटन विवरण दोनों गोलघर को मध्य पटना के गांधी मैदान–अशोक राजपथ क्षेत्र से जोड़ते हैं।</p></div><div class="card p-7"><p class="eyebrow">फोटोग्राफी</p><h2 class="mt-3 text-3xl font-black">वक्रता और सीढ़ियों पर ध्यान दें</h2><p class="mt-4 muted">अर्धगोलाकार दीवार और बाहरी सीढ़ी गोलघर की सबसे विशिष्ट दृश्य पहचान हैं।</p></div></div></div></section>
<section id="faq" class="section bg-[#efe7db]"><div class="shell max-w-4xl"><p class="eyebrow">FAQ</p><h2 class="section-title mt-3">अक्सर पूछे जाने वाले सवाल</h2><div class="mt-8 space-y-4"><details class="card p-6" open><summary class="cursor-pointer font-black">गोलघर कब बना?</summary><p class="mt-3 muted">1786 में, कैप्टन जॉन गार्स्टिन द्वारा।</p></details><details class="card p-6"><summary class="cursor-pointer font-black">क्या ऊपर तक जाना हमेशा संभव है?</summary><p class="mt-3 muted">सीढ़ियों या ऊपरी भाग की पहुँच सुरक्षा, रखरखाव या स्थानीय निर्देश के कारण बदल सकती है। स्थल पर नवीनतम सूचना देखें।</p></details><details class="card p-6"><summary class="cursor-pointer font-black">क्या कैमरा ले जा सकते हैं?</summary><p class="mt-3 muted">बिहार पर्यटन की आधिकारिक जानकारी में मोबाइल, कैमरा और इलेक्ट्रॉनिक गैजेट्स की अनुमति बताई गई है; स्थानीय सुरक्षा निर्देश लागू रहेंगे।</p></details><details class="card p-6"><summary class="cursor-pointer font-black">आधिकारिक जानकारी कहाँ देखें?</summary><p class="mt-3 muted"><a class="underline" href="https://tourism.bihar.gov.in/hi/destinations/patna/gol-ghar" target="_blank" rel="noopener">बिहार पर्यटन</a> और <a class="underline" href="https://patna.nic.in/tourist-place/gol-ghar/" target="_blank" rel="noopener">पटना जिला प्रशासन</a> प्राथमिक संदर्भ हैं।</p></details></div></div></section>
</Base>
